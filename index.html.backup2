<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global Gateway Benchmarking Tool</title>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .form-container { background: white; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
        .section-title { border-left: 4px solid #667eea; padding-left: 12px; }
        input[type="text"], input[type="email"], input[type="password"], input[type="number"], input[type="date"], select, textarea { transition: border-color 0.3s; }
        input:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1); outline: none; }
    </style>
</head>
<body>
    <div id="root"></div>
    
    <script type="text/babel">
        const { useState, useEffect } = React;

        function App() {
            const [page, setPage] = useState('auth');
            const [authMode, setAuthMode] = useState('login');
            const [token, setToken] = useState(localStorage.getItem('token'));
            const [user, setUser] = useState(null);
            const [loading, setLoading] = useState(false);
            const [message, setMessage] = useState('');

            useEffect(() => {
                if (token) {
                    loadUserProfile();
                }
            }, [token]);

            const loadUserProfile = async () => {
                try {
                    const response = await fetch('/api/user/profile', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (response.ok) {
                        const data = await response.json();
                        setUser(data);
                        setPage('dashboard');
                    } else {
                        logout();
                    }
                } catch (error) {
                    console.error('Profile load error:', error);
                }
            };

            const logout = () => {
                localStorage.removeItem('token');
                setToken(null);
                setUser(null);
                setPage('auth');
                setMessage('');
            };

            return (
                <div className="min-h-screen py-8 px-4">
                    <div className="max-w-4xl mx-auto">
                        {page === 'auth' && <AuthPage authMode={authMode} setAuthMode={setAuthMode} setToken={setToken} setMessage={setMessage} message={message} />}
                        {page === 'dashboard' && token && user && <Dashboard user={user} token={token} logout={logout} setPage={setPage} />}
                        {page === 'intro' && token && <IntroPage setPage={setPage} />}
                        {page === 'project' && token && <ProjectForm token={token} setPage={setPage} />}
                        {page === 'firm' && token && <FirmForm token={token} setPage={setPage} />}
                    </div>
                </div>
            );
        }

        function AuthPage({ authMode, setAuthMode, setToken, setMessage, message }) {
            const [loading, setLoading] = useState(false);
            const [formData, setFormData] = useState({
                username: '',
                email: '',
                password: '',
                organization: '',
                country: ''
            });

            const handleRegister = async (e) => {
                e.preventDefault();
                setLoading(true);
                try {
                    const response = await fetch('/api/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formData)
                    });
                    const data = await response.json();
                    if (response.ok) {
                        localStorage.setItem('token', data.token);
                        setToken(data.token);
                        setMessage('✅ Registration successful!');
                    } else {
                        setMessage('❌ ' + data.error);
                    }
                } catch (error) {
                    setMessage('❌ Error: ' + error.message);
                }
                setLoading(false);
            };

            const handleLogin = async (e) => {
                e.preventDefault();
                setLoading(true);
                try {
                    const response = await fetch('/api/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: formData.email, password: formData.password })
                    });
                    const data = await response.json();
                    if (response.ok) {
                        localStorage.setItem('token', data.token);
                        setToken(data.token);
                        setMessage('✅ Login successful!');
                    } else {
                        setMessage('❌ ' + data.error);
                    }
                } catch (error) {
                    setMessage('❌ Error: ' + error.message);
                }
                setLoading(false);
            };

            return (
                <div className="form-container p-8 mb-6">
                    <div className="text-center text-white mb-8">
                        <h1 className="text-4xl font-bold mb-2">Global Gateway Benchmarking Tool</h1>
                        <p className="text-lg opacity-90">Job Creation & Competitiveness Study - Uganda Local Construction Industry</p>
                    </div>

                    {message && (
                        <div className="mb-6 p-4 rounded bg-blue-50 border-l-4 border-blue-500">
                            <p className="text-blue-800 text-center font-semibold">{message}</p>
                        </div>
                    )}

                    <div className="form-container p-8">
                        <h2 className="text-3xl font-bold text-gray-800 mb-8 text-center">{authMode === 'login' ? 'Login' : 'Register'}</h2>

                        <form onSubmit={authMode === 'login' ? handleLogin : handleRegister} className="space-y-4">
                            {authMode === 'register' && (
                                <>
                                    <div>
                                        <label className="block text-sm font-medium text-gray-700 mb-2">Username</label>
                                        <input type="text" value={formData.username} onChange={(e) => setFormData({...formData, username: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Choose username" required />
                                    </div>
                                </>
                            )}

                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-2">Email</label>
                                <input type="email" value={formData.email} onChange={(e) => setFormData({...formData, email: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="your@email.com" required />
                            </div>

                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-2">Password</label>
                                <input type="password" value={formData.password} onChange={(e) => setFormData({...formData, password: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="••••••••" required />
                            </div>

                            {authMode === 'register' && (
                                <>
                                    <div>
                                        <label className="block text-sm font-medium text-gray-700 mb-2">Organization</label>
                                        <input type="text" value={formData.organization} onChange={(e) => setFormData({...formData, organization: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Your organization" />
                                    </div>

                                    <div>
                                        <label className="block text-sm font-medium text-gray-700 mb-2">Country</label>
                                        <input type="text" value={formData.country} onChange={(e) => setFormData({...formData, country: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Your country" required />
                                    </div>
                                </>
                            )}

                            <button type="submit" disabled={loading} className="w-full bg-gradient-to-r from-purple-600 to-purple-700 text-white font-bold py-3 px-6 rounded-lg hover:from-purple-700 hover:to-purple-800 disabled:opacity-50">
                                {loading ? 'Processing...' : authMode === 'login' ? 'Sign In' : 'Create Account'}
                            </button>
                        </form>

                        <div className="text-center mt-6">
                            <p className="text-gray-600">
                                {authMode === 'login' ? "Don't have an account?" : 'Already have an account?'}
                                <button onClick={() => setAuthMode(authMode === 'login' ? 'register' : 'login')} className="text-purple-600 font-bold ml-2">
                                    {authMode === 'login' ? 'Register' : 'Login'}
                                </button>
                            </p>
                        </div>
                    </div>
                </div>
            );
        }

        function Dashboard({ user, token, logout, setPage }) {
            const [projectDrafts, setProjectDrafts] = useState([]);
            const [firmDrafts, setFirmDrafts] = useState([]);
            const [loading, setLoading] = useState(true);

            useEffect(() => {
                loadDrafts();
            }, []);

            const loadDrafts = async () => {
                try {
                    const [projRes, firmRes] = await Promise.all([
                        fetch('/api/user/project-drafts', { headers: { 'Authorization': `Bearer ${token}` } }),
                        fetch('/api/user/firm-drafts', { headers: { 'Authorization': `Bearer ${token}` } })
                    ]);
                    if (projRes.ok) setProjectDrafts((await projRes.json()).drafts || []);
                    if (firmRes.ok) setFirmDrafts((await firmRes.json()).drafts || []);
                } catch (error) {
                    console.error('Error loading drafts:', error);
                }
                setLoading(false);
            };

            return (
                <div>
                    <div className="text-center text-white mb-8">
                        <h1 className="text-4xl font-bold mb-2">Global Gateway Benchmarking Tool</h1>
                        <p className="text-lg opacity-90">Welcome, {user.username}!</p>
                    </div>

                    <div className="form-container p-8 mb-6">
                        <div className="flex justify-between items-center mb-6">
                            <div>
                                <h2 className="text-2xl font-bold text-gray-800">Dashboard</h2>
                                <p className="text-gray-600">{user.organization} • {user.country}</p>
                            </div>
                            <button onClick={logout} className="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg">Logout</button>
                        </div>

                        <button onClick={() => setPage('intro')} className="w-full bg-blue-50 border-2 border-blue-500 text-blue-800 font-bold py-4 px-6 rounded-lg mb-6 hover:bg-blue-100">
                            📖 Read Study Introduction (Part A)
                        </button>

                        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                            <button onClick={() => setPage('project')} className="bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-bold py-4 px-6 rounded-lg">
                                📝 Fill New Project Form
                            </button>
                            <button onClick={() => setPage('firm')} className="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-4 px-6 rounded-lg">
                                📝 Fill New Firm Form
                            </button>
                        </div>

                        <div className="bg-gray-50 p-6 rounded-lg">
                            <h3 className="text-lg font-bold text-gray-800 mb-4">📋 My Drafts</h3>
                            {loading ? (
                                <p className="text-gray-600">Loading drafts...</p>
                            ) : projectDrafts.length === 0 && firmDrafts.length === 0 ? (
                                <p className="text-gray-600">No drafts yet. Start a new form!</p>
                            ) : (
                                <div className="space-y-3">
                                    {projectDrafts.map(draft => (
                                        <div key={draft.draft_id} className="bg-white p-3 rounded border border-gray-300 flex justify-between items-center">
                                            <span className="text-gray-700"><strong>Project:</strong> {draft.draft_id} • {new Date(draft.updated_at).toLocaleDateString()}</span>
                                            <button onClick={() => setPage('project')} className="text-purple-600 font-bold">Resume →</button>
                                        </div>
                                    ))}
                                    {firmDrafts.map(draft => (
                                        <div key={draft.draft_id} className="bg-white p-3 rounded border border-gray-300 flex justify-between items-center">
                                            <span className="text-gray-700"><strong>Firm:</strong> {draft.draft_id} • {new Date(draft.updated_at).toLocaleDateString()}</span>
                                            <button onClick={() => setPage('firm')} className="text-blue-600 font-bold">Resume →</button>
                                        </div>
                                    ))}
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            );
        }

        function IntroPage({ setPage }) {
            return (
                <div className="form-container p-8 mb-6">
                    <button onClick={() => setPage('dashboard')} className="text-gray-500 hover:text-gray-700 text-2xl mb-4">← Back</button>
                    
                    <h2 className="text-3xl font-bold text-gray-800 mb-6">Part A: Introduction</h2>

                    <div className="prose prose-sm max-w-none mb-6 space-y-4">
                        <p className="text-gray-700 leading-relaxed">
                            <strong>PROJECT SC N° 300145105 / Study on the job creation potential and competitiveness of Uganda's local construction industry: Boosting the implementation of Global Gateway in Uganda</strong>
                        </p>

                        <p className="text-gray-700 leading-relaxed">
                            <strong>Respondents: Global Gateway Project Managers and Implementing Firms</strong>
                        </p>

                        <p className="text-gray-700 leading-relaxed">
                            The European Union Delegation (EUD) in Uganda contracted IBF Impact Consortium to conduct a study on the Job Creation Potential and Competitiveness of Uganda's Local Construction Industry (LCI): Boosting the Implementation of Global Gateway in Uganda. Under the auspices of IBF Impact Consortium, this study is being undertaken by a team of seven (7) multidisciplinary experts with adequate experience in Uganda's LCI. The study commenced on 2nd February 2026 and is expected to be completed by 31st March 2027.
                        </p>

                        <p className="text-gray-700 leading-relaxed">
                            As part of the study, this benchmarking tool has been developed to collect data for measuring and comparing the performance of the Local Construction Industry Global Gateway Projects and Implementing Firms, within and outside Uganda. The lessons learnt from benchmarking assessment alongside other findings of the study will inform the development of the National Strategic Programme for Performance Improvement and an operational Strategic Implementation Plan.
                        </p>

                        <p className="text-gray-700 leading-relaxed">
                            The benchmarking tool is being administered to ten (10) in-country projects, with at least two drawn from each Global Gateway sector (transport, energy, digital, and water). To enable comparative analysis, the same tool is being administered to projects from two (2) peer regional countries and one (1) International Country. One country is drawn from the Eastern-Central-Western Africa block, one country from the Southern Africa regional block and one country from the ASIA block.
                        </p>

                        <div className="bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded mt-4">
                            <p className="text-yellow-800 font-semibold">
                                The team guarantees maximum confidentiality of the information provided by respondents. This information will solely be used for this study.
                            </p>
                        </div>

                        <p className="text-gray-700 leading-relaxed mt-4">
                            <strong>We greatly thank you for your cooperation.</strong>
                        </p>
                    </div>

                    <button onClick={() => setPage('dashboard')} className="w-full bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white font-bold py-3 px-6 rounded-lg">
                        I Understand • Return to Dashboard
                    </button>
                </div>
            );
        }

        function ProjectForm({ token, setPage }) {
            const [projectData, setProjectData] = useState({
                project_id: '',
                project_title: '',
                implementing_agency: '',
                funding_agency: '',
                implementing_firm: '',
                initial_cost: '',
                start_date: '',
                duration: ''
            });
            const [loading, setLoading] = useState(false);
            const [message, setMessage] = useState('');

            const formatCurrency = (value) => {
                if (!value) return '';
                return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            };

            const handleChange = (field, value) => {
                setProjectData({...projectData, [field]: value});
            };

            const handleSubmit = async () => {
                setLoading(true);
                try {
                    const response = await fetch('/api/submit-project', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify(projectData)
                    });
                    if (response.ok) {
                        setMessage('✅ Project submitted successfully!');
                        setTimeout(() => setPage('dashboard'), 2000);
                    } else {
                        setMessage('❌ Submission failed');
                    }
                } catch (error) {
                    setMessage('❌ Error: ' + error.message);
                }
                setLoading(false);
            };

            return (
                <div className="form-container p-8">
                    <button onClick={() => setPage('dashboard')} className="text-gray-500 hover:text-gray-700 text-2xl mb-4">← Back</button>
                    
                    <h2 className="text-2xl font-bold text-gray-800 mb-6">Part B: Project Level Benchmarking</h2>

                    {message && (
                        <div className="mb-6 p-4 rounded bg-blue-50 border-l-4 border-blue-500">
                            <p className="text-blue-800 text-center font-semibold">{message}</p>
                        </div>
                    )}

                    <div className="mb-8">
                        <h3 className="text-xl font-bold text-gray-800 section-title mb-4">B.1 Project Profile</h3>
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <input type="text" value={projectData.project_id} onChange={(e) => handleChange('project_id', e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" placeholder="Project ID" />
                            <input type="text" value={projectData.project_title} onChange={(e) => handleChange('project_title', e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" placeholder="Project Title" />
                            <input type="text" value={projectData.implementing_agency} onChange={(e) => handleChange('implementing_agency', e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" placeholder="Implementing Agency" />
                            <input type="text" value={projectData.funding_agency} onChange={(e) => handleChange('funding_agency', e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" placeholder="Funding Agency" />
                            <input type="text" value={projectData.implementing_firm} onChange={(e) => handleChange('implementing_firm', e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" placeholder="Implementing Firm" />
                            <div>
                            <label className="text-xs text-gray-600">Initial Project Cost (USD)</label>
                            <input type="number" value={projectData.initial_cost} onChange={(e) => handleChange('initial_cost', e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg w-full" placeholder="e.g., 2500000" />
                            {projectData.initial_cost && <p className="text-xs text-gray-500 mt-1">Formatted: {formatCurrency(projectData.initial_cost)}</p>}
                            </div>
                            <input type="date" value={projectData.start_date} onChange={(e) => handleChange('start_date', e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                            <input type="number" step="0.1" value={projectData.duration} onChange={(e) => handleChange('duration', e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" placeholder="Duration (years)" />
                        </div>
                    </div>

                    <p className="text-gray-600 text-sm mb-6 bg-yellow-50 p-3 rounded">
                        📋 <strong>Note:</strong> Additional performance metrics (B.2) will be available in the next phase. For now, please fill the project profile above.
                    </p>

                    <div className="flex gap-4">
                        <button onClick={() => setPage('dashboard')} className="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 px-6 rounded-lg">← Back</button>
                        <button onClick={handleSubmit} disabled={loading} className="flex-1 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-bold py-3 px-6 rounded-lg disabled:opacity-50">
                            {loading ? 'Submitting...' : '✅ Submit Project'}
                        </button>
                    </div>
                </div>
            );
        }

        function FirmForm({ token, setPage }) {
            const [firmData, setFirmData] = useState({
                firm_name: ''
            });
            const [loading, setLoading] = useState(false);
            const [message, setMessage] = useState('');

            const handleChange = (field, value) => {
                setFirmData({...firmData, [field]: value});
            };

            const handleSubmit = async () => {
                setLoading(true);
                try {
                    const response = await fetch('/api/submit-firm', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify(firmData)
                    });
                    if (response.ok) {
                        setMessage('✅ Firm submitted successfully!');
                        setTimeout(() => setPage('dashboard'), 2000);
                    } else {
                        setMessage('❌ Submission failed');
                    }
                } catch (error) {
                    setMessage('❌ Error: ' + error.message);
                }
                setLoading(false);
            };

            return (
                <div className="form-container p-8">
                    <button onClick={() => setPage('dashboard')} className="text-gray-500 hover:text-gray-700 text-2xl mb-4">← Back</button>
                    
                    <h2 className="text-2xl font-bold text-gray-800 mb-6">Part C: Firm/Contractor Level Benchmarking</h2>

                    {message && (
                        <div className="mb-6 p-4 rounded bg-blue-50 border-l-4 border-blue-500">
                            <p className="text-blue-800 text-center font-semibold">{message}</p>
                        </div>
                    )}

                    <div className="mb-8">
                        <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.1 Firm Information</h3>
                        <input type="text" value={firmData.firm_name} onChange={(e) => handleChange('firm_name', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Firm/Contractor Name" required />
                    </div>

                    <p className="text-gray-600 text-sm mb-6 bg-yellow-50 p-3 rounded">
                        📋 <strong>Note:</strong> Additional performance metrics (C.1) will be available in the next phase. For now, please fill the firm information above.
                    </p>

                    <div className="flex gap-4">
                        <button onClick={() => setPage('dashboard')} className="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 px-6 rounded-lg">← Back</button>
                        <button onClick={handleSubmit} disabled={loading} className="flex-1 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-3 px-6 rounded-lg disabled:opacity-50">
                            {loading ? 'Submitting...' : '✅ Submit Firm'}
                        </button>
                    </div>
                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>
