<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global Gateway Benchmarking Tool</title>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .form-container { background: white; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
        .section-title { border-left: 4px solid #667eea; padding-left: 12px; }
        input:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1); outline: none; }
        .progress-bar { background: #e5e7eb; height: 8px; border-radius: 4px; overflow: hidden; }
        .progress-fill { background: #667eea; height: 100%; transition: width 0.3s; }
        .draft-indicator { background: #dbeafe; border-left: 4px solid #3b82f6; padding: 12px; border-radius: 4px; margin-bottom: 16px; }
        .draft-indicator p { margin: 0; font-size: 14px; color: #1e40af; }
        .auto-save { font-size: 12px; color: #6b7280; margin-top: 8px; }
        .save-btn { background: #3b82f6; color: white; }
    </style>
</head>
<body>
    <div id="root"></div>
    
    <script type="text/babel">
        const { useState, useEffect } = React;

        function App() {
            const [page, setPage] = useState('auth');
            const [authMode, setAuthMode] = useState('login');
            const [token, setToken] = useState(localStorage.getItem('token'));
            const [user, setUser] = useState(null);
            const [message, setMessage] = useState('');

            useEffect(() => {
                if (token) loadUserProfile();
            }, [token]);

            const loadUserProfile = async () => {
                try {
                    const response = await fetch('/api/user/profile', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (response.ok) {
                        setUser(await response.json());
                        setPage('dashboard');
                    } else {
                        logout();
                    }
                } catch (error) {
                    logout();
                }
            };

            const logout = () => {
                localStorage.removeItem('token');
                setToken(null);
                setUser(null);
                setPage('auth');
            };

            return (
                <div className="min-h-screen py-8 px-4">
                    <div className="max-w-4xl mx-auto">
                        {page === 'auth' && <AuthPage authMode={authMode} setAuthMode={setAuthMode} setToken={setToken} setMessage={setMessage} message={message} />}
                        {page === 'dashboard' && token && user && <Dashboard user={user} token={token} logout={logout} setPage={setPage} />}
                        {page === 'intro' && <IntroPage setPage={setPage} />}
                        {page === 'project' && token && <ProjectFormMultiStep token={token} setPage={setPage} />}
                        {page === 'firm' && token && <FirmFormMultiStep token={token} setPage={setPage} />}
                    </div>
                </div>
            );
        }

        function AuthPage({ authMode, setAuthMode, setToken, setMessage, message }) {
            const [loading, setLoading] = useState(false);
            const [formData, setFormData] = useState({ username: '', email: '', password: '', organization: '', country: '' });

            const handleRegister = async (e) => {
                e.preventDefault();
                setLoading(true);
                try {
                    const response = await fetch('/api/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formData)
                    });
                    const data = await response.json();
                    if (response.ok) {
                        localStorage.setItem('token', data.token);
                        setToken(data.token);
                    } else {
                        setMessage('❌ ' + data.error);
                    }
                } catch (error) {
                    setMessage('❌ Error: ' + error.message);
                }
                setLoading(false);
            };

            const handleLogin = async (e) => {
                e.preventDefault();
                setLoading(true);
                try {
                    const response = await fetch('/api/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: formData.email, password: formData.password })
                    });
                    const data = await response.json();
                    if (response.ok) {
                        localStorage.setItem('token', data.token);
                        setToken(data.token);
                    } else {
                        setMessage('❌ ' + data.error);
                    }
                } catch (error) {
                    setMessage('❌ Error: ' + error.message);
                }
                setLoading(false);
            };

            return (
                <div>
                    <div className="text-center text-white mb-8">
                        <h1 className="text-4xl font-bold mb-2">Global Gateway Benchmarking Tool</h1>
                        <p className="text-lg opacity-90">Job Creation & Competitiveness Study</p>
                    </div>
                    {message && <div className="mb-6 p-4 rounded bg-blue-50 border-l-4 border-blue-500"><p className="text-blue-800 text-center">{message}</p></div>}
                    <div className="form-container p-8">
                        <h2 className="text-3xl font-bold text-gray-800 mb-8 text-center">{authMode === 'login' ? 'Login' : 'Register'}</h2>
                        <form onSubmit={authMode === 'login' ? handleLogin : handleRegister} className="space-y-4">
                            {authMode === 'register' && <div><label className="block text-sm font-medium text-gray-700 mb-2">Username</label><input type="text" required value={formData.username} onChange={(e) => setFormData({...formData, username: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" /></div>}
                            <div><label className="block text-sm font-medium text-gray-700 mb-2">Email</label><input type="email" required value={formData.email} onChange={(e) => setFormData({...formData, email: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" /></div>
                            <div><label className="block text-sm font-medium text-gray-700 mb-2">Password</label><input type="password" required value={formData.password} onChange={(e) => setFormData({...formData, password: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" /></div>
                            {authMode === 'register' && (
                                <>
                                    <div><label className="block text-sm font-medium text-gray-700 mb-2">Organization</label><input type="text" value={formData.organization} onChange={(e) => setFormData({...formData, organization: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" /></div>
                                    <div><label className="block text-sm font-medium text-gray-700 mb-2">Country</label><input type="text" required value={formData.country} onChange={(e) => setFormData({...formData, country: e.target.value})} className="w-full px-4 py-2 border border-gray-300 rounded-lg" /></div>
                                </>
                            )}
                            <button type="submit" disabled={loading} className="w-full bg-gradient-to-r from-purple-600 to-purple-700 text-white font-bold py-3 px-6 rounded-lg disabled:opacity-50">{loading ? 'Processing...' : authMode === 'login' ? 'Sign In' : 'Create Account'}</button>
                        </form>
                        <div className="text-center mt-6"><p className="text-gray-600">{authMode === 'login' ? "Don't have an account?" : 'Already have an account?'} <button onClick={() => setAuthMode(authMode === 'login' ? 'register' : 'login')} className="text-purple-600 font-bold">{authMode === 'login' ? 'Register' : 'Login'}</button></p></div>
                    </div>
                </div>
            );
        }

        function Dashboard({ user, token, logout, setPage }) {
            return (
                <div>
                    <div className="text-center text-white mb-8">
                        <h1 className="text-4xl font-bold mb-2">Global Gateway Benchmarking Tool</h1>
                        <p className="text-lg opacity-90">Welcome, {user.username}!</p>
                    </div>
                    <div className="form-container p-8 mb-6">
                        <div className="flex justify-between items-center mb-6">
                            <h2 className="text-2xl font-bold text-gray-800">Dashboard</h2>
                            <button onClick={logout} className="bg-red-600 text-white font-bold py-2 px-4 rounded-lg">Logout</button>
                        </div>
                        <button onClick={() => setPage('intro')} className="w-full bg-blue-50 border-2 border-blue-500 text-blue-800 font-bold py-4 px-6 rounded-lg mb-6">📖 Read Study Introduction</button>
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <button onClick={() => setPage('project')} className="bg-gradient-to-r from-purple-600 to-purple-700 text-white font-bold py-4 px-6 rounded-lg">📝 Project Form</button>
                            <button onClick={() => setPage('firm')} className="bg-gradient-to-r from-blue-600 to-blue-700 text-white font-bold py-4 px-6 rounded-lg">📝 Firm Form</button>
                        </div>
                    </div>
                </div>
            );
        }

        function IntroPage({ setPage }) {
            return (
                <div className="form-container p-8 mb-6">
                    <button onClick={() => setPage('dashboard')} className="text-gray-500 text-2xl mb-4">← Back</button>
                    <h2 className="text-3xl font-bold text-gray-800 mb-6">Part A: Introduction</h2>
                    <div className="space-y-4 text-gray-700 leading-relaxed">
                        <p><strong>Study on the job creation potential and competitiveness of Uganda's local construction industry</strong></p>
                        <p><strong>Respondents: Global Gateway Project Managers and Implementing Firms</strong></p>
                        <p>The European Union Delegation (EUD) in Uganda contracted IBF Impact Consortium to conduct a study on the Job Creation Potential and Competitiveness of Uganda's Local Construction Industry (LCI). This study is being undertaken by a team of multidisciplinary experts and commenced on 2nd February 2026, expected to be completed by 31st March 2027.</p>
                        <p>This benchmarking tool has been developed to collect data for measuring and comparing the performance of the Local Construction Industry Global Gateway Projects and Implementing Firms.</p>
                        <div className="bg-yellow-50 border-l-4 border-yellow-500 p-4"><p className="text-yellow-800 font-semibold">The team guarantees maximum confidentiality. This information will solely be used for this study.</p></div>
                        <p><strong>We greatly thank you for your cooperation.</strong></p>
                    </div>
                    <button onClick={() => setPage('dashboard')} className="w-full bg-gradient-to-r from-green-600 to-green-700 text-white font-bold py-3 px-6 rounded-lg mt-6">I Understand • Return to Dashboard</button>
                </div>
            );
        }

        function ProjectFormMultiStep({ token, setPage }) {
            const [step, setStep] = useState(1);
            const [loading, setLoading] = useState(false);
            const [message, setMessage] = useState('');
            const [draftId, setDraftId] = useState('');
            const [autoSaveStatus, setAutoSaveStatus] = useState('');
            const [projectData, setProjectData] = useState({
                project_id: '', project_title: '', implementing_agency: '', funding_agency: '', implementing_firm: '', initial_cost: '', start_date: '', duration: '',
                cost_metrics: {}, schedule_metrics: {}, quality_metrics: {}, local_content_metrics: {}, safety_metrics: {}
            });

            // Load existing draft on mount
            useEffect(() => {
                loadDraftIfExists();
            }, []);

            // Auto-save every 30 seconds
            useEffect(() => {
                const autoSaveInterval = setInterval(() => {
                    if (draftId && projectData.project_id) {
                        saveDraftSilent();
                    }
                }, 30000);
                return () => clearInterval(autoSaveInterval);
            }, [draftId, projectData]);

            const loadDraftIfExists = async () => {
                const savedDraftId = localStorage.getItem('projectDraftId');
                if (savedDraftId) {
                    try {
                        const response = await fetch(`/api/load-project-draft/${savedDraftId}`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        if (response.ok) {
                            const data = await response.json();
                            setProjectData(data.project_data);
                            setDraftId(savedDraftId);
                            setMessage('✅ Previous draft loaded!');
                            setTimeout(() => setMessage(''), 3000);
                        }
                    } catch (error) {
                        console.error('Error loading draft:', error);
                    }
                }
            };

            const saveDraftSilent = async () => {
                if (!draftId) return;
                try {
                    await fetch('/api/save-project-draft', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                        body: JSON.stringify({ draft_id: draftId, project_data: projectData })
                    });
                    setAutoSaveStatus('Auto-saved');
                    setTimeout(() => setAutoSaveStatus(''), 2000);
                } catch (error) {
                    console.error('Auto-save error:', error);
                }
            };

            const saveDraft = async () => {
                const newDraftId = draftId || 'draft_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
                setLoading(true);
                try {
                    const response = await fetch('/api/save-project-draft', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                        body: JSON.stringify({ draft_id: newDraftId, project_data: projectData })
                    });
                    if (response.ok) {
                        setDraftId(newDraftId);
                        localStorage.setItem('projectDraftId', newDraftId);
                        setMessage(`✅ Draft saved! ID: ${newDraftId}`);
                        setTimeout(() => setPage('dashboard'), 2000);
                    }
                } catch (error) {
                    setMessage('❌ Save failed: ' + error.message);
                }
                setLoading(false);
            };

            const formatNumber = (value) => {
                if (!value) return '';
                return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            };

            const handleCurrencyInput = (e) => {
                let value = e.target.value.replace(/,/g, '');
                setProjectData({...projectData, initial_cost: value});
            };

            const handleChange = (field, value) => {
                setProjectData({...projectData, [field]: value});
            };

            const handleMetricChange = (category, metricKey, value) => {
                setProjectData({
                    ...projectData,
                    [category]: {...projectData[category], [metricKey]: value}
                });
            };

            const handleSubmit = async () => {
                setLoading(true);
                try {
                    const response = await fetch('/api/submit-project', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                        body: JSON.stringify(projectData)
                    });
                    if (response.ok) {
                        localStorage.removeItem('projectDraftId');
                        setMessage('✅ Project submitted successfully!');
                        setTimeout(() => setPage('dashboard'), 2000);
                    } else {
                        setMessage('❌ Submission failed');
                    }
                } catch (error) {
                    setMessage('❌ Error: ' + error.message);
                }
                setLoading(false);
            };

            const progressPercent = (step / 7) * 100;

            return (
                <div className="form-container p-8">
                    <button onClick={() => setPage('dashboard')} className="text-gray-500 text-2xl mb-4">← Back</button>
                    
                    {draftId && (
                        <div className="draft-indicator">
                            <p><strong>📝 Draft ID:</strong> {draftId}</p>
                            <p className="text-xs mt-1">Copy this ID to resume later on any device</p>
                            {autoSaveStatus && <p className="auto-save">✓ {autoSaveStatus}</p>}
                        </div>
                    )}

                    <h2 className="text-2xl font-bold text-gray-800 mb-2">Part B: Project Level Benchmarking</h2>
                    <p className="text-gray-600 mb-4">Step {step} of 7</p>

                    <div className="progress-bar mb-4">
                        <div className="progress-fill" style={{width: progressPercent + '%'}}></div>
                    </div>

                    {message && <div className="mb-6 p-4 rounded bg-blue-50 border-l-4 border-blue-500"><p className="text-blue-800">{message}</p></div>}

                    {/* STEP 1: Project Profile */}
                    {step === 1 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">B.1 Project Profile</h3>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div><label className="text-sm font-medium text-gray-700">Project ID</label><input type="text" value={projectData.project_id} onChange={(e) => handleChange('project_id', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Project ID" /></div>
                                <div><label className="text-sm font-medium text-gray-700">Project Title</label><input type="text" value={projectData.project_title} onChange={(e) => handleChange('project_title', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Project Title" /></div>
                                <div><label className="text-sm font-medium text-gray-700">Implementing Agency/MDA</label><input type="text" value={projectData.implementing_agency} onChange={(e) => handleChange('implementing_agency', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Agency" /></div>
                                <div><label className="text-sm font-medium text-gray-700">Funding Agency</label><input type="text" value={projectData.funding_agency} onChange={(e) => handleChange('funding_agency', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Funding" /></div>
                                <div><label className="text-sm font-medium text-gray-700">Implementing Firm/Contractor</label><input type="text" value={projectData.implementing_firm} onChange={(e) => handleChange('implementing_firm', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Firm" /></div>
                                <div><label className="text-sm font-medium text-gray-700">Initial Project Cost (USD)</label><input type="text" value={formatNumber(projectData.initial_cost)} onChange={handleCurrencyInput} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="e.g., 2,500,000" /></div>
                                <div><label className="text-sm font-medium text-gray-700">Project Start Date</label><input type="date" value={projectData.start_date} onChange={(e) => handleChange('start_date', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" /></div>
                                <div><label className="text-sm font-medium text-gray-700">Project Duration (years)</label><input type="number" step="0.1" value={projectData.duration} onChange={(e) => handleChange('duration', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Years" /></div>
                            </div>
                        </div>
                    )}

                    {/* STEP 2: Cost Performance */}
                    {step === 2 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">B.2.1 Cost Performance (20%)</h3>
                            <div className="space-y-4">
                                {['Cost Variation (%)', 'Unit Cost', 'Change Orders Ratio', 'Payment Compliance', 'Procurement Savings Ratio'].map((metric, i) => (
                                    <div key={i}>
                                        <label className="text-sm font-medium text-gray-700">{metric}</label>
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                                            <input type="text" placeholder="Assessment Result" value={projectData.cost_metrics[`${i}_result`] || ''} onChange={(e) => handleMetricChange('cost_metrics', `${i}_result`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                            <input type="text" placeholder="Data Source" value={projectData.cost_metrics[`${i}_source`] || ''} onChange={(e) => handleMetricChange('cost_metrics', `${i}_source`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* STEP 3: Schedule Performance */}
                    {step === 3 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">B.2.2 Schedule Performance (20%)</h3>
                            <div className="space-y-4">
                                {['Schedule Variation', 'Milestone Consistency', 'Days lost to rain/floods', 'RFI Response Time', 'RFC Response Time'].map((metric, i) => (
                                    <div key={i}>
                                        <label className="text-sm font-medium text-gray-700">{metric}</label>
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                                            <input type="text" placeholder="Assessment Result" value={projectData.schedule_metrics[`${i}_result`] || ''} onChange={(e) => handleMetricChange('schedule_metrics', `${i}_result`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                            <input type="text" placeholder="Data Source" value={projectData.schedule_metrics[`${i}_source`] || ''} onChange={(e) => handleMetricChange('schedule_metrics', `${i}_source`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* STEP 4: Quality Performance */}
                    {step === 4 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">B.2.3 Quality Performance (20%)</h3>
                            <div className="space-y-4">
                                {['Defect Density', 'Material Test Pass Rate', 'Quality Compliance', 'Technology Adoption', 'Rework Costs Ratio'].map((metric, i) => (
                                    <div key={i}>
                                        <label className="text-sm font-medium text-gray-700">{metric}</label>
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                                            <input type="text" placeholder="Assessment Result" value={projectData.quality_metrics[`${i}_result`] || ''} onChange={(e) => handleMetricChange('quality_metrics', `${i}_result`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                            <input type="text" placeholder="Data Source" value={projectData.quality_metrics[`${i}_source`] || ''} onChange={(e) => handleMetricChange('quality_metrics', `${i}_source`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* STEP 5: Local Content & Job Creation */}
                    {step === 5 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">B.2.4 Local Content & Job Creation (25%)</h3>
                            <div className="space-y-4">
                                {['Local Workforce Intensity', 'Skill Transfer Ratio', 'Local Material (200km)', 'Sub-contracting Ratio', 'Local Procurement %', 'Skill Development Spending', 'Skill Development Hours', 'Workforce Skill Levels', 'Avg Skilled Earnings', 'Avg Semi-skilled Earnings', 'Apprenticeships Ratio'].map((metric, i) => (
                                    <div key={i}>
                                        <label className="text-sm font-medium text-gray-700">{metric}</label>
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                                            <input type="text" placeholder="Assessment Result" value={projectData.local_content_metrics[`${i}_result`] || ''} onChange={(e) => handleMetricChange('local_content_metrics', `${i}_result`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                            <input type="text" placeholder="Data Source" value={projectData.local_content_metrics[`${i}_source`] || ''} onChange={(e) => handleMetricChange('local_content_metrics', `${i}_source`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* STEP 6: Safety & Environment */}
                    {step === 6 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">B.2.5 Safety, Environmental & Cross Cutting (15%)</h3>
                            <div className="space-y-4">
                                {['Accident Incidence Rate', 'Accident Costs Ratio', 'PPE Availability', 'Environmental Compliance', 'Sustainable Materials', 'Waste Management %', 'Female Ratio', 'Youth Ratio'].map((metric, i) => (
                                    <div key={i}>
                                        <label className="text-sm font-medium text-gray-700">{metric}</label>
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                                            <input type="text" placeholder="Assessment Result" value={projectData.safety_metrics[`${i}_result`] || ''} onChange={(e) => handleMetricChange('safety_metrics', `${i}_result`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                            <input type="text" placeholder="Data Source" value={projectData.safety_metrics[`${i}_source`] || ''} onChange={(e) => handleMetricChange('safety_metrics', `${i}_source`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* STEP 7: Review & Submit */}
                    {step === 7 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">Review & Submit</h3>
                            <div className="bg-green-50 border-l-4 border-green-500 p-4 rounded">
                                <p className="text-green-800"><strong>✅ All sections complete!</strong></p>
                                <p className="text-green-700 mt-2">Click Submit to save your project data permanently.</p>
                            </div>
                        </div>
                    )}

                    {/* Navigation Buttons */}
                    <div className="flex gap-2 mt-8 flex-wrap">
                        <button onClick={() => {
                            if (step > 1) setStep(step - 1);
                            else setPage('dashboard');
                        }} className="flex-1 min-w-[100px] bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 px-6 rounded-lg">← Back</button>
                        
                        <button onClick={saveDraft} disabled={loading} className="flex-1 min-w-[120px] save-btn hover:bg-blue-600 font-bold py-3 px-6 rounded-lg disabled:opacity-50">💾 Save & Exit</button>
                        
                        {step < 7 ? (
                            <button onClick={() => setStep(step + 1)} className="flex-1 min-w-[100px] bg-gradient-to-r from-purple-600 to-purple-700 text-white font-bold py-3 px-6 rounded-lg">Next →</button>
                        ) : (
                            <button onClick={handleSubmit} disabled={loading} className="flex-1 min-w-[140px] bg-gradient-to-r from-green-600 to-green-700 text-white font-bold py-3 px-6 rounded-lg disabled:opacity-50">{loading ? 'Submitting...' : '✅ Submit'}</button>
                        )}
                    </div>
                </div>
            );
        }

        function FirmFormMultiStep({ token, setPage }) {
            const [step, setStep] = useState(1);
            const [loading, setLoading] = useState(false);
            const [message, setMessage] = useState('');
            const [draftId, setDraftId] = useState('');
            const [autoSaveStatus, setAutoSaveStatus] = useState('');
            const [firmData, setFirmData] = useState({
                firm_name: '',
                financial_metrics: {}, competitiveness_metrics: {}, customer_metrics: {}, tech_metrics: {}, communication_metrics: {}, collaboration_metrics: {}, employee_metrics: {}, product_metrics: {}
            });

            useEffect(() => {
                loadDraftIfExists();
            }, []);

            useEffect(() => {
                const autoSaveInterval = setInterval(() => {
                    if (draftId && firmData.firm_name) {
                        saveDraftSilent();
                    }
                }, 30000);
                return () => clearInterval(autoSaveInterval);
            }, [draftId, firmData]);

            const loadDraftIfExists = async () => {
                const savedDraftId = localStorage.getItem('firmDraftId');
                if (savedDraftId) {
                    try {
                        const response = await fetch(`/api/load-firm-draft/${savedDraftId}`, {
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        if (response.ok) {
                            const data = await response.json();
                            setFirmData(data.firm_data);
                            setDraftId(savedDraftId);
                            setMessage('✅ Previous draft loaded!');
                            setTimeout(() => setMessage(''), 3000);
                        }
                    } catch (error) {
                        console.error('Error loading draft:', error);
                    }
                }
            };

            const saveDraftSilent = async () => {
                if (!draftId) return;
                try {
                    await fetch('/api/save-firm-draft', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                        body: JSON.stringify({ draft_id: draftId, firm_data: firmData })
                    });
                    setAutoSaveStatus('Auto-saved');
                    setTimeout(() => setAutoSaveStatus(''), 2000);
                } catch (error) {
                    console.error('Auto-save error:', error);
                }
            };

            const saveDraft = async () => {
                const newDraftId = draftId || 'draft_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
                setLoading(true);
                try {
                    const response = await fetch('/api/save-firm-draft', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                        body: JSON.stringify({ draft_id: newDraftId, firm_data: firmData })
                    });
                    if (response.ok) {
                        setDraftId(newDraftId);
                        localStorage.setItem('firmDraftId', newDraftId);
                        setMessage(`✅ Draft saved! ID: ${newDraftId}`);
                        setTimeout(() => setPage('dashboard'), 2000);
                    }
                } catch (error) {
                    setMessage('❌ Save failed: ' + error.message);
                }
                setLoading(false);
            };

            const handleChange = (field, value) => {
                setFirmData({...firmData, [field]: value});
            };

            const handleMetricChange = (category, metricKey, value) => {
                setFirmData({...firmData, [category]: {...firmData[category], [metricKey]: value}});
            };

            const handleSubmit = async () => {
                setLoading(true);
                try {
                    const response = await fetch('/api/submit-firm', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                        body: JSON.stringify(firmData)
                    });
                    if (response.ok) {
                        localStorage.removeItem('firmDraftId');
                        setMessage('✅ Firm submitted successfully!');
                        setTimeout(() => setPage('dashboard'), 2000);
                    } else {
                        setMessage('❌ Submission failed');
                    }
                } catch (error) {
                    setMessage('❌ Error: ' + error.message);
                }
                setLoading(false);
            };

            const progressPercent = (step / 9) * 100;

            const MetricInput = ({ category, index, label }) => (
                <div>
                    <label className="text-sm font-medium text-gray-700">{label}</label>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <input type="text" placeholder="Assessment Result" value={firmData[category][`${index}_result`] || ''} onChange={(e) => handleMetricChange(category, `${index}_result`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                        <input type="text" placeholder="Data Source" value={firmData[category][`${index}_source`] || ''} onChange={(e) => handleMetricChange(category, `${index}_source`, e.target.value)} className="px-4 py-2 border border-gray-300 rounded-lg" />
                    </div>
                </div>
            );

            return (
                <div className="form-container p-8">
                    <button onClick={() => setPage('dashboard')} className="text-gray-500 text-2xl mb-4">← Back</button>
                    
                    {draftId && (
                        <div className="draft-indicator">
                            <p><strong>📝 Draft ID:</strong> {draftId}</p>
                            <p className="text-xs mt-1">Copy this ID to resume later on any device</p>
                            {autoSaveStatus && <p className="auto-save">✓ {autoSaveStatus}</p>}
                        </div>
                    )}

                    <h2 className="text-2xl font-bold text-gray-800 mb-2">Part C: Firm/Contractor Benchmarking</h2>
                    <p className="text-gray-600 mb-4">Step {step} of 9</p>
                    <div className="progress-bar mb-4">
                        <div className="progress-fill" style={{width: progressPercent + '%'}}></div>
                    </div>
                    {message && <div className="mb-6 p-4 rounded bg-blue-50 border-l-4 border-blue-500"><p className="text-blue-800">{message}</p></div>}

                    {step === 1 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.1 Firm Information</h3>
                            <input type="text" value={firmData.firm_name} onChange={(e) => handleChange('firm_name', e.target.value)} className="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Firm/Contractor Name" />
                        </div>
                    )}

                    {step === 2 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.2.1 Financial Performance (15%)</h3>
                            <div className="space-y-4">
                                {['Gross Profit Margin', 'Net Profit Margin', 'Return on Assets', 'Admin Costs Ratio', 'Debt Ratio', 'Working Capital', 'Backlog Profit'].map((m, i) => <MetricInput key={i} category="financial_metrics" index={i} label={m} />)}
                            </div>
                        </div>
                    )}

                    {step === 3 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.2.2 Competitiveness (25%)</h3>
                            <div className="space-y-4">
                                {['Bid Success Rate', 'Market Surveys', 'CapEX Ratio', 'Tax Compliance', 'Health & Safety', 'Human Capital', 'Training Investment', 'Female Ratio'].map((m, i) => <MetricInput key={i} category="competitiveness_metrics" index={i} label={m} />)}
                            </div>
                        </div>
                    )}

                    {step === 4 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.2.3 Customer Satisfaction (10%)</h3>
                            <div className="space-y-4">
                                {['Satisfaction Scores', 'Acceptance Rate', 'Complaint Rate'].map((m, i) => <MetricInput key={i} category="customer_metrics" index={i} label={m} />)}
                            </div>
                        </div>
                    )}

                    {step === 5 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.2.4 Technology Advancement (10%)</h3>
                            <div className="space-y-4">
                                {['Tech Investment', 'R&D Investment', 'Digital Skills'].map((m, i) => <MetricInput key={i} category="tech_metrics" index={i} label={m} />)}
                            </div>
                        </div>
                    )}

                    {step === 6 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.2.5 Communication Framework (10%)</h3>
                            <div className="space-y-4">
                                {['Web Communication', 'Staff Meetings', 'Document Compliance'].map((m, i) => <MetricInput key={i} category="communication_metrics" index={i} label={m} />)}
                            </div>
                        </div>
                    )}

                    {step === 7 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.2.6 Collaboration (10%)</h3>
                            <div className="space-y-4">
                                {['Teamwork', 'CSR Ratio', 'RFI Time', 'Conflict Resolution'].map((m, i) => <MetricInput key={i} category="collaboration_metrics" index={i} label={m} />)}
                            </div>
                        </div>
                    )}

                    {step === 8 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">C.2.7 Employee Satisfaction (10%) & C.2.8 Product Orientation (10%)</h3>
                            <div className="space-y-4">
                                <div>
                                    <h4 className="font-semibold text-gray-800 mb-2">Employee Satisfaction</h4>
                                    {['Incentives', 'Compensation', 'Leave', 'Welfare'].map((m, i) => <MetricInput key={i} category="employee_metrics" index={i} label={m} />)}
                                </div>
                                <div className="mt-6">
                                    <h4 className="font-semibold text-gray-800 mb-2">Product Orientation</h4>
                                    {['Quality Certification', 'Quality Officers', 'Marketing', 'Delivery Precision', 'Cost Precision'].map((m, i) => <MetricInput key={i} category="product_metrics" index={i} label={m} />)}
                                </div>
                            </div>
                        </div>
                    )}

                    {step === 9 && (
                        <div>
                            <h3 className="text-xl font-bold text-gray-800 section-title mb-4">Review & Submit</h3>
                            <div className="bg-green-50 border-l-4 border-green-500 p-4 rounded">
                                <p className="text-green-800"><strong>✅ All sections complete!</strong></p>
                                <p className="text-green-700 mt-2">Click Submit to save your firm data permanently.</p>
                            </div>
                        </div>
                    )}

                    <div className="flex gap-2 mt-8 flex-wrap">
                        <button onClick={() => {
                            if (step > 1) setStep(step - 1);
                            else setPage('dashboard');
                        }} className="flex-1 min-w-[100px] bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 px-6 rounded-lg">← Back</button>
                        
                        <button onClick={saveDraft} disabled={loading} className="flex-1 min-w-[120px] save-btn hover:bg-blue-600 font-bold py-3 px-6 rounded-lg disabled:opacity-50">💾 Save & Exit</button>
                        
                        {step < 9 ? (
                            <button onClick={() => setStep(step + 1)} className="flex-1 min-w-[100px] bg-gradient-to-r from-blue-600 to-blue-700 text-white font-bold py-3 px-6 rounded-lg">Next →</button>
                        ) : (
                            <button onClick={handleSubmit} disabled={loading} className="flex-1 min-w-[140px] bg-gradient-to-r from-green-600 to-green-700 text-white font-bold py-3 px-6 rounded-lg disabled:opacity-50">{loading ? 'Submitting...' : '✅ Submit'}</button>
                        )}
                    </div>
                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>